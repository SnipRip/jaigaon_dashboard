// Data model for the dashboard backend. Run `npm run db:migrate` after editing.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  fullName          String
  displayName       String
  phone             String?
  role              Role      @default(STAFF)
  isActive          Boolean   @default(true)
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
}

// One row per signed-in device. Only the SHA-256 of the cookie token is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

// Proof of consent for WhatsApp messaging, as required by Meta's opt-in policy.
model WhatsappOptIn {
  id             String    @id @default(uuid()) @db.Uuid
  phoneE164      String    @unique
  name           String
  businessName   String?
  consentText    String
  consentVersion String
  source         String
  ipAddress      String?
  userAgent      String?
  optedInAt      DateTime  @default(now())
  optedOutAt     DateTime?
}
