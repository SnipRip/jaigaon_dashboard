// Data model for the dashboard backend. Run `npm run db:migrate` after editing.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ADMIN may do everything, including managing users and roles. STAFF may do
// what their access role allows.
enum Role {
  ADMIN
  STAFF
}

// What a staff member may do in each module. `permissions` maps a dashboard
// module href ("/items") to the actions allowed there: view, create, edit,
// delete. Administrators ignore it.
model AccessRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                 String      @id @default(uuid()) @db.Uuid
  email              String      @unique
  fullName           String
  displayName        String
  phone              String?
  role               Role        @default(STAFF)
  accessRoleId       String?     @db.Uuid
  accessRole         AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: Restrict)
  isActive           Boolean     @default(true)
  // Set when an administrator creates the account or resets its password:
  // the person must choose their own password before using the app.
  mustChangePassword Boolean     @default(false)
  lastSignInAt       DateTime?
  passwordHash       String
  passwordChangedAt  DateTime    @default(now())
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  sessions           Session[]
  importJobs         ImportJob[]
  pricesSet          ItemPrice[] @relation("ItemPriceCreatedBy")
  pricesChanged      ItemPrice[] @relation("ItemPriceUpdatedBy")

  @@index([accessRoleId])
}

// One row per signed-in device. Only the SHA-256 of the cookie token is stored.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

// Proof of consent for WhatsApp messaging, as required by Meta's opt-in policy.
model WhatsappOptIn {
  id             String    @id @default(uuid()) @db.Uuid
  phoneE164      String    @unique
  name           String
  businessName   String?
  consentText    String
  consentVersion String
  source         String
  ipAddress      String?
  userAgent      String?
  optedInAt      DateTime  @default(now())
  optedOutAt     DateTime?
}

// ---------------------------------------------------------------------------
// Item master (agent/masters-plan.md, section C). Category → sub-category →
// optional item group → item. Only items hold stock; the levels above carry
// defaults (HSN, GST rate, unit) that an item inherits unless it overrides
// them. Records in use are archived, never deleted (foreign keys restrict).
// ---------------------------------------------------------------------------

enum UnitKind {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  AREA
}

model Unit {
  id         String   @id @default(uuid()) @db.Uuid
  // As printed on documents: kg, pcs, bag.
  symbol     String   @unique
  name       String
  kind       UnitKind
  // Decimals allowed in quantities.
  decimals   Int      @default(0)
  // Unit code used by e-way bills and e-invoices (UQC).
  uqc        String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryDefaults ItemCategory[]
  groupDefaults    ItemGroup[]
  items            Item[]
  conversions      ItemUnitConversion[]
}

model Brand {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  // The category the brand mostly sells in.
  categoryId   String?       @db.Uuid
  category     ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isAuthorised Boolean       @default(false)
  notes        String?
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  groups ItemGroup[]
  items  Item[]
}

enum GodownKind {
  STORE
  YARD
  SITE
}

model Godown {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  address    String
  kind       GodownKind
  // At most one godown is the default; the service keeps it that way.
  isDefault  Boolean    @default(false)
  inCharge   String?
  phone      String?
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  openingStock ItemOpeningStock[]
}

// Both category levels. A row with no parent is a category; a row with a
// parent is a sub-category. Only two levels: a sub-category is never a parent.
model ItemCategory {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  parentId      String?        @db.Uuid
  parent        ItemCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Restrict)
  subCategories ItemCategory[] @relation("SubCategories")
  // Defaults for everything below. Null means inherit from the parent.
  hsn           String?
  gstRatePct    Decimal?       @db.Decimal(5, 2)
  defaultUnitId String?        @db.Uuid
  defaultUnit   Unit?          @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  sortOrder     Int            @default(0)
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  brands           Brand[]
  groups           ItemGroup[] @relation("GroupCategory")
  subGroups        ItemGroup[] @relation("GroupSubCategory")
  items            Item[]      @relation("ItemCategory")
  subCategoryItems Item[]      @relation("ItemSubCategory")
  specialRates     SpecialRate[]

  // Postgres treats NULL parents as distinct, so the service also checks
  // that top-level names are unique.
  @@unique([parentId, name])
  @@index([parentId])
}

// Variants that differ only by attribute (TMT bar → 8, 10, 12 mm). A group
// never holds stock; its items do.
model ItemGroup {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  skuPrefix     String        @unique
  categoryId    String        @db.Uuid
  category      ItemCategory  @relation("GroupCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId String?       @db.Uuid
  subCategory   ItemCategory? @relation("GroupSubCategory", fields: [subCategoryId], references: [id], onDelete: Restrict)
  brandId       String?       @db.Uuid
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  description   String?
  // [{ "name": "Size", "options": ["8 mm", "10 mm"] }], one to three attributes.
  attributes    Json
  hsn           String?
  gstRatePct    Decimal?      @db.Decimal(5, 2)
  defaultUnitId String?       @db.Uuid
  defaultUnit   Unit?         @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items Item[]
}

model Item {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  sku               String        @unique
  categoryId        String        @db.Uuid
  category          ItemCategory  @relation("ItemCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId     String?       @db.Uuid
  subCategory       ItemCategory? @relation("ItemSubCategory", fields: [subCategoryId], references: [id], onDelete: Restrict)
  groupId           String?       @db.Uuid
  group             ItemGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  // Attribute name → option, for items in a group: { "Size": "12 mm" }.
  attributeValues   Json?
  brandId           String?       @db.Uuid
  brand             Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  description       String?
  // Every item carries its own HSN (client, 28 Oct 2026).
  hsn               String
  // Overrides only; null inherits from group, sub-category, category.
  gstRatePct        Decimal?      @db.Decimal(5, 2)
  unitId            String?       @db.Uuid
  unit              Unit?         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  // Kilograms per base unit, for truck load and e-way bill weight.
  weightKg          Decimal?      @db.Decimal(12, 3)
  mrp               Decimal?      @db.Decimal(12, 2)
  preferredSupplier String?
  reorderLevel      Decimal       @default(0) @db.Decimal(14, 3)
  isArchived        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  alternateUnits ItemUnitConversion[]
  openingStock   ItemOpeningStock[]
  specialRates   SpecialRate[]
  priceList      ItemPrice[]
  picture        ItemPicture?

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([groupId])
}

// One picture per item, kept in the database rather than on disk: it goes
// into the same backup as the item, leaves with it (cascade) in the same
// transaction, and needs no upload folder kept across deploys on the shared
// server. At 1 MB each (CHECK in migration 20261104032204_item_pictures) a
// few thousand items stay well within what Postgres handles. A separate
// table so item lists never read the bytes.
model ItemPicture {
  itemId      String   @id @db.Uuid
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Worked out from the file's first bytes, never taken from the upload.
  contentType String
  bytes       Bytes
  updatedAt   DateTime @updatedAt
}

// "1 bundle = 25 kg": an alternate unit and how many base units one of it holds.
model ItemUnitConversion {
  id           String  @id @default(uuid()) @db.Uuid
  itemId       String  @db.Uuid
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId       String  @db.Uuid
  unit         Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  baseQuantity Decimal @db.Decimal(14, 4)

  @@unique([itemId, unitId])
}

// Opening stock per godown. Stock on hand will be this plus movements, once
// purchases, sales and stock journals are stored.
model ItemOpeningStock {
  itemId   String  @db.Uuid
  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  godownId String  @db.Uuid
  godown   Godown  @relation(fields: [godownId], references: [id], onDelete: Restrict)
  quantity Decimal @db.Decimal(14, 3)
  // The opening batch at its landed cost: quantity × the row's rate when
  // not given. The item's costs are worked out from these (item-costs.ts).
  value    Decimal @db.Decimal(14, 2)

  @@id([itemId, godownId])
}

// ---------------------------------------------------------------------------
// Parties (masters-plan.md, section B). One record per customer or vendor;
// a party can be both, as Zoho's contacts are.
// ---------------------------------------------------------------------------

enum PartyKind {
  BUSINESS
  INDIVIDUAL
}

// Decides the tax on every document with the party (frontend gst-rules.ts).
enum GstTreatment {
  REGISTERED
  COMPOSITION
  UNREGISTERED
  CONSUMER
  OVERSEAS
  SEZ
}

enum ExportRoute {
  LUT
  IGST
}

enum PartyCurrency {
  INR
  BTN
}

// Which way the opening balance runs: they owe us, or we owe them.
enum BalanceSide {
  RECEIVABLE
  PAYABLE
}

model Party {
  id                 String        @id @default(uuid()) @db.Uuid
  isCustomer         Boolean       @default(false)
  isVendor           Boolean       @default(false)
  kind               PartyKind     @default(BUSINESS)
  // Shown on quotations and invoices.
  displayName        String
  legalName          String?
  contactPerson      String?
  // E.164, for calls and WhatsApp.
  phone              String?
  email              String?

  treatment          GstTreatment
  // Unique when present: the same GSTIN is the same registered business.
  gstin              String?       @unique
  pan                String?
  // GST state code ("19"). Null for a party outside India.
  placeOfSupply      String?
  // Outside India only.
  country            String?
  // Outside India: the buyer's own tax ID, e.g. Bhutan TPN.
  foreignTaxId       String?
  currency           PartyCurrency @default(INR)
  // Customers outside India: export under LUT or with IGST paid.
  exportRoute        ExportRoute?
  // Vendors: goods transport agency, freight under reverse charge.
  isGta              Boolean       @default(false)

  addressLine        String?
  city               String?
  pin                String?

  // 0 is cash.
  creditDays         Int           @default(0)
  creditLimit        Decimal?      @db.Decimal(14, 2)
  openingBalance     Decimal       @default(0) @db.Decimal(14, 2)
  openingBalanceSide BalanceSide   @default(RECEIVABLE)
  // Vendors: MSME vendors must be paid within 45 days.
  udyamNumber        String?
  bankName           String?
  bankAccountNumber  String?
  ifsc               String?
  notes              String?

  isArchived         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  specialRates SpecialRate[]

  @@index([isCustomer])
  @@index([isVendor])
}

// ---------------------------------------------------------------------------
// HSN / SAC master (masters-plan.md, section D). Rates change by
// notification, so each code keeps a dated rate history; a document uses
// the rate in force on its own date. Items keep their HSN as text and take
// the most specific code here that it starts with (72142090 → 7214).
// ---------------------------------------------------------------------------

enum CodeKind {
  HSN
  SAC
}

model HsnCode {
  id            String    @id @default(uuid()) @db.Uuid
  // HSN for goods: 4, 6 or 8 digits. SAC for services: 4 or 6, starting 99.
  code          String    @unique
  kind          CodeKind
  description   String
  cessPct       Decimal?  @db.Decimal(5, 2)
  // Bought under reverse charge (goods transport agency freight).
  reverseCharge Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rates HsnRate[]
}

model HsnRate {
  id            String   @id @default(uuid()) @db.Uuid
  hsnCodeId     String   @db.Uuid
  hsnCode       HsnCode  @relation(fields: [hsnCodeId], references: [id], onDelete: Cascade)
  ratePct       Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime @db.Date

  @@unique([hsnCodeId, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Pricing (agent/selling-rate-plan.md). The item master has no selling
// price: rates change every day. A customer's rate for an item is, in order:
// a special rate in force for that customer, else the rate-sheet price in
// force on the date (ItemPrice), else none and the user types it
// (src/pricing/pricing-rules.ts). A special rate is for one item or a whole
// category / sub-category: exactly one of itemId and categoryId.
// ---------------------------------------------------------------------------

enum SpecialRateKind {
  // A rate in rupees per base unit.
  NET
  // A discount % off the day's rate-sheet price (off MRP when there is none).
  DISCOUNT
}

model SpecialRate {
  id         String          @id @default(uuid()) @db.Uuid
  partyId    String          @db.Uuid
  party      Party           @relation(fields: [partyId], references: [id], onDelete: Restrict)
  itemId     String?         @db.Uuid
  item       Item?           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  categoryId String?         @db.Uuid
  category   ItemCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kind       SpecialRateKind
  value      Decimal         @db.Decimal(12, 2)
  validFrom  DateTime        @db.Date
  // Null: until withdrawn.
  validTill  DateTime?       @db.Date
  notes      String?
  isArchived Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([partyId])
}

// Day-wise price list (agent/price-list-plan.md): an item's price for one
// day (validTill = validFrom) or a range. Entries layer: on a date the latest
// start wins, then the shorter range (src/price-list/price-list-rules.ts).
// With no entry in force there is no list rate: the user types one.
// CHECKs in migration item_price_list: till ≥ from, price > 0, minimum ≤
// price ≤ MRP where given, cost ≥ 0.
model ItemPrice {
  id              String   @id @default(uuid()) @db.Uuid
  itemId          String   @db.Uuid
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  validFrom       DateTime @db.Date
  validTill       DateTime @db.Date
  sellingPrice    Decimal  @db.Decimal(12, 2)
  // Null: the item's MRP.
  mrp             Decimal? @db.Decimal(12, 2)
  // The floor for these days; only the rate sheet has one.
  minSellingPrice Decimal? @db.Decimal(12, 2)
  // The day's cost, for the margin; null: the last landed cost.
  costPrice       Decimal? @db.Decimal(12, 2)
  notes           String?
  isArchived      Boolean  @default(false)
  createdById     String?  @db.Uuid
  createdBy       User?    @relation("ItemPriceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?  @db.Uuid
  updatedBy       User?    @relation("ItemPriceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // One item and date range is one entry (the import's natural key).
  @@unique([itemId, validFrom, validTill])
  @@index([validFrom, validTill])
}

// ── Company profile ──────────────────────────────────────────────────────

// The business itself: one row (id 1, CHECK constraint and first row in
// migration company_profile). Its state decides CGST+SGST or IGST on every
// document; invoices and quotations print the rest.
model CompanyProfile {
  id                 Int           @id @default(1)
  legalName          String
  // Shown on documents when it differs from the legal name.
  tradeName          String?
  gstin              String?
  pan                String?
  // GST state code of our registration ("19", West Bengal).
  stateCode          String
  // Importer-Exporter Code from DGFT.
  iec                String?
  addressLine        String?
  city               String?
  district           String?
  pin                String?
  // E.164.
  phone              String?
  altPhone           String?
  email              String?
  // Bank that receives export payments. The AD code is per year, beside the LUT.
  exportBank         String?
  customsStation     String?
  portCode           String?
  defaultExportRoute ExportRoute   @default(LUT)
  exportCurrency     PartyCurrency @default(INR)
  updatedAt          DateTime      @updatedAt
}

// One financial year's export registrations: the LUT (form RFD-11 on the GST
// portal), which lets an export go out without IGST, and the AD code, which
// the client says is issued afresh every year (28 Oct 2026). An export
// invoice under LUT quotes the one in force on its date.
model Lut {
  id            String   @id @default(uuid()) @db.Uuid
  // "2026-27", from validFrom. An LUT never spans two financial years.
  financialYear String   @unique
  // ARN of the RFD-11 acknowledgement.
  arn           String   @unique
  adCode        String?
  validFrom     DateTime @db.Date
  validTo       DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Everything the client numbers: documents and master codes. Each kind has
// one series (rows seeded by migration 20261103045732_numbering). What each
// kind must obey (GST rules, unique per year or for ever, Tally voucher
// type) is in src/number-series/numbered-kinds.ts.
enum NumberedKind {
  QUOTATION
  SALES_INVOICE
  EXPORT_INVOICE
  PURCHASE
  RECEIPT
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  // Entries where no money moves (interest credited to a loan).
  JOURNAL
  STOCK_JOURNAL
  SHIPMENT
  EXPENSE
  CUSTOMER_CODE
  VENDOR_CODE
  ITEM_SKU
}

// Tally's voucher numbering methods. Automatic: the number is always taken
// from the series. Manual override: taken from the series unless the person
// types one. Manual: always typed. Duplicates are always refused.
enum NumberingMethod {
  AUTOMATIC
  AUTOMATIC_MANUAL_OVERRIDE
  MANUAL
}

// When the running number starts again (Tally's "restart numbering").
enum NumberReset {
  YEARLY
  MONTHLY
  NEVER
}

enum IssuedNumberStatus {
  ISSUED
  CANCELLED
}

// One kind's numbering: the method, the Tally voucher type its documents
// sync to, and its formats over time.
model NumberSeries {
  id               String          @id @default(uuid()) @db.Uuid
  kind             NumberedKind    @unique
  method           NumberingMethod @default(AUTOMATIC)
  // Voucher type name in Tally ("Sales"); null for kinds Tally has no voucher for.
  tallyVoucherType String?
  formats          NumberFormat[]
  updatedAt        DateTime        @updatedAt
}

// A pattern in force from a date, like Tally's prefix and suffix
// "applicable from". "INV/{FY}/{SEQ:4}" → INV/2627/0001. A document uses the
// latest format starting on or before its date. A format that has issued a
// number is locked; a change of format is a new format from a later date,
// with its own counter.
model NumberFormat {
  id             String          @id @default(uuid()) @db.Uuid
  seriesId       String          @db.Uuid
  series         NumberSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  applicableFrom DateTime        @db.Date
  pattern        String
  // First number of the format's first period; later periods start at 1.
  startNumber    Int             @default(1)
  reset          NumberReset     @default(YEARLY)
  counters       NumberCounter[]
  issued         IssuedNumber[]
  createdAt      DateTime        @default(now())

  @@unique([seriesId, applicableFrom])
}

// The next running number of a format in one period ("2026-27", "2026-11",
// or "ALL" when it never resets). Incremented in place, so claims never
// share a number.
model NumberCounter {
  formatId   String       @db.Uuid
  format     NumberFormat @relation(fields: [formatId], references: [id], onDelete: Restrict)
  period     String
  nextNumber Int

  @@id([formatId, period])
}

// Every number given out, automatic or typed. The unique index keeps a full
// number unique within its scope (sales and export invoices share one, as
// the e-invoice portal checks them together) and its financial year, or for
// ever for master codes ("ALL"). A cancelled number stays: GSTR-1 table 13
// reports it, and it is never reused.
model IssuedNumber {
  id           String             @id @default(uuid()) @db.Uuid
  kind         NumberedKind
  scope        String
  uniqueWithin String
  number       String
  // Null for a typed number.
  formatId     String?            @db.Uuid
  format       NumberFormat?      @relation(fields: [formatId], references: [id], onDelete: Restrict)
  sequence     Int?
  documentDate DateTime           @db.Date
  // The document or master record carrying it, once those are built.
  documentId   String?            @db.Uuid
  status       IssuedNumberStatus @default(ISSUED)
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())

  @@unique([scope, uniqueWithin, number])
  @@index([kind, uniqueWithin])
}

// ---------------------------------------------------------------------------
// Bank and cash accounts (masters-plan.md, row 22). Each is a Tally ledger
// under Bank Accounts, Bank OD A/c or Cash-in-Hand (bank-cash-rules.ts).
// ---------------------------------------------------------------------------

enum BankCashKind {
  BANK
  // Overdraft or cash credit: the only kind that may open below zero.
  OVERDRAFT
  CASH
}

// A cash account has no bank fields, and only a bank kind needs all of bank
// name, account number and IFSC: CHECK constraints in migration
// 20261103051950_bank_cash_accounts keep that true.
model BankCashAccount {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @unique
  kind            BankCashKind
  bankName        String?
  branch          String?
  accountNumber   String?
  ifsc            String?
  upiId           String?
  // Positive is money we hold; negative is overdraft used (OVERDRAFT only).
  openingBalance  Decimal      @default(0) @db.Decimal(14, 2)
  openingDate     DateTime     @db.Date
  // At most one account prints its bank details on invoices; the service
  // keeps it that way, as for the default godown.
  showOnInvoice   Boolean      @default(false)
  // Null: the Tally ledger carries the account name.
  tallyLedgerName String?      @unique
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  loansDisbursed  Loan[]        @relation("LoanDisbursedThrough")
  loansRepaid     Loan[]        @relation("LoanRepaidThrough")
  loanEntries     LoanEntry[]

  @@unique([ifsc, accountNumber])
}

// ---------------------------------------------------------------------------
// Loans we take and loans we give, with a fixed EMI or flexible repayment
// (agent/accounts-plan.md). Each loan is a Tally ledger: Secured or
// Unsecured Loans when taken; Loans & Advances (Asset) or Deposits (Asset)
// when given. Each entry is a Payment, Receipt or Journal voucher. Schedules
// are worked out, not stored (src/loans/loan-schedule.ts).
// ---------------------------------------------------------------------------

enum LoanDirection {
  // We owe it.
  TAKEN
  // It is owed to us.
  GIVEN
}

// Which kinds fit which direction is in src/loans/loan-kinds.ts.
enum LoanKind {
  VEHICLE
  EQUIPMENT
  PROPERTY
  BUSINESS
  GOLD
  // From owners, directors, partners or their relatives.
  OWNER
  // Salary advance to a staff member.
  STAFF
  // Security deposit we give (rent, electricity, tender).
  DEPOSIT
  OTHER
}

enum LoanRepayment {
  EMI
  // No EMI: principal whenever, interest on its own dates.
  FLEXIBLE
}

// How often a flexible loan's interest falls due.
enum InterestFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  AT_MATURITY
}

// How the loan's first entry goes to Tally.
enum LoanDisbursal {
  // Already running when these books start: an opening balance.
  BEFORE_BOOKS
  // Through our bank: a Receipt (taken) or Payment (given).
  THROUGH_BANK
  // Taken only: a Journal, Dr the asset bought (Fixed Assets), Cr the loan.
  PAID_TO_SELLER
}

// CHECK constraints in migration 20261103070000_loan_kinds keep each
// direction, repayment style and disbursal with its own fields.
model Loan {
  id                 String             @id @default(uuid()) @db.Uuid
  // The Tally ledger name.
  name               String             @unique
  direction          LoanDirection
  kind               LoanKind
  repayment          LoanRepayment
  // The lender (taken) or the borrower (given).
  partyName          String
  loanAccountNumber  String?
  isSecured          Boolean
  // What secures it: "Truck WB73E1234 hypothecated".
  security           String?
  // The first amount; later amounts are DRAWDOWN entries.
  principal          Decimal            @db.Decimal(14, 2)
  interestRatePct    Decimal            @db.Decimal(5, 2)
  disbursedOn        DateTime           @db.Date
  disbursal          LoanDisbursal
  disbursalAccountId String?            @db.Uuid
  disbursalAccount   BankCashAccount?   @relation("LoanDisbursedThrough", fields: [disbursalAccountId], references: [id], onDelete: Restrict)
  // PAID_TO_SELLER only: the Fixed Assets ledger the loan paid for.
  assetLedgerId      String?            @db.Uuid
  assetLedger        Ledger?            @relation("LoanAssetLedger", fields: [assetLedgerId], references: [id], onDelete: Restrict)
  // BEFORE_BOOKS only: EMIs already paid (EMI loans), and what was owed after them.
  paidBefore         Int                @default(0)
  openingOutstanding Decimal?           @db.Decimal(14, 2)
  // EMI loans.
  tenureMonths       Int?
  emiAmount          Decimal?           @db.Decimal(14, 2)
  firstEmiDate       DateTime?          @db.Date
  // Flexible loans.
  interestFrequency  InterestFrequency?
  firstInterestDate  DateTime?          @db.Date
  maturityDate       DateTime?          @db.Date
  // The account EMIs, interest and repayments go through.
  repaymentAccountId String             @db.Uuid
  repaymentAccount   BankCashAccount    @relation("LoanRepaidThrough", fields: [repaymentAccountId], references: [id], onDelete: Restrict)
  // The expense head (taken) or income head (given) interest posts to. Null:
  // the direction's default ledger (src/common/tally/tally-groups.ts).
  interestHeadId     String?            @db.Uuid
  interestHead       AccountHead?       @relation(fields: [interestHeadId], references: [id], onDelete: Restrict)
  // TDS on interest (non-bank lenders and borrowers); null: none.
  tdsRatePct         Decimal?           @db.Decimal(5, 2)
  // Null: TDS Payable on Interest (taken) or TDS Receivable (given).
  tdsLedgerId        String?            @db.Uuid
  tdsLedger          Ledger?            @relation("LoanTdsLedger", fields: [tdsLedgerId], references: [id], onDelete: Restrict)
  // Days before a due date that it shows as due soon.
  reminderDays       Int                @default(3)
  notes              String?
  isArchived         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entries LoanEntry[]

  @@index([interestHeadId])
  @@index([assetLedgerId])
  @@index([tdsLedgerId])
}

// What an entry does to a loan; its voucher depends on the loan's direction
// (agent/accounts-plan.md, "Entries").
enum LoanEntryKind {
  // An instalment of an EMI loan: principal and interest.
  EMI
  // Principal repaid (a repayment or prepayment).
  PRINCIPAL
  // Interest paid or received.
  INTEREST
  // Interest credited to the loan; no money moves (Journal).
  INTEREST_ADDED
  // More borrowed or lent.
  DRAWDOWN
}

// One voucher against a loan. A mistaken one is cancelled, never deleted,
// and its voucher number stays cancelled in the number register.
model LoanEntry {
  id             String           @id @default(uuid()) @db.Uuid
  loanId         String           @db.Uuid
  loan           Loan             @relation(fields: [loanId], references: [id], onDelete: Restrict)
  kind           LoanEntryKind
  // The schedule row it settles: an EMI, or a flexible loan's interest date.
  instalmentNo   Int?
  entryDate      DateTime         @db.Date
  principal      Decimal          @default(0) @db.Decimal(14, 2)
  // Gross interest, before TDS.
  interest       Decimal          @default(0) @db.Decimal(14, 2)
  tds            Decimal          @default(0) @db.Decimal(14, 2)
  // Bounce, penal or processing charges on a loan taken, to Bank Charges.
  charges        Decimal          @default(0) @db.Decimal(14, 2)
  // Null only for INTEREST_ADDED.
  bankAccountId  String?          @db.Uuid
  bankAccount    BankCashAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  // UTR, NACH or cheque reference.
  reference      String?
  voucherNumber  String
  issuedNumberId String           @unique @db.Uuid
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([loanId, entryDate])
}

// ---------------------------------------------------------------------------
// Expense and income heads (masters-plan.md, rows 23 and 24). Each is a Tally
// ledger whose group follows its nature (account-head-rules.ts): Direct or
// Indirect Expenses, Direct or Indirect Incomes. The name is the ledger name.
// ---------------------------------------------------------------------------

enum HeadNature {
  DIRECT_EXPENSE
  INDIRECT_EXPENSE
  DIRECT_INCOME
  INDIRECT_INCOME
}

// How an expense head's bills carry GST.
enum HeadGst {
  // Takes the goods bill's rate (freight and loading on a goods bill).
  FOLLOWS_BILL
  OWN_RATE
  NONE
}

// Where an expense head's cost lands for actual profit (SOW 14).
enum HeadAllocation {
  // Landed cost, spread over the items of a purchase.
  ITEM_COST
  INVOICE
  SHIPMENT
  OVERHEAD
}

// GST and allocation belong to expense heads only, a rate to OWN_RATE only,
// and an indirect expense is always an overhead: CHECK constraints in
// migration 20261103072017_account_heads keep that true.
model AccountHead {
  id          String          @id @default(uuid()) @db.Uuid
  // The Tally ledger name.
  name        String          @unique
  nature      HeadNature
  gst         HeadGst?
  gstRatePct  Decimal?        @db.Decimal(5, 2)
  allocation  HeadAllocation?
  notes       String?
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Loans whose interest posts to this head.
  loans Loan[]
}

// ---------------------------------------------------------------------------
// Master imports from Excel (src/imports). A job remembers the next row to
// read, so uploading the same rows again after a failure carries on from
// there instead of starting over. Rows that cannot be saved are kept with
// the reason, for the "skipped rows" sheet.
// ---------------------------------------------------------------------------

enum ImportStatus {
  RUNNING
  // Stopped part way (server restart, error); the same file resumes it.
  STOPPED
  DONE
}

model ImportJob {
  id          String             @id @default(uuid()) @db.Uuid
  // Importer key: "units", "customers" … (src/imports/importers).
  master      String
  fileName    String
  // SHA-256 of the master, headings and cell values: the same rows saved
  // again in Excel still match.
  fingerprint String
  // The uploaded headings, for the skipped-rows sheet.
  headers     Json
  totalRows   Int
  // Index of the next data row to read (0 = the row under the headings).
  nextRow     Int                @default(0)
  created     Int                @default(0)
  updated     Int                @default(0)
  skipped     Int                @default(0)
  status      ImportStatus       @default(RUNNING)
  error       String?
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  skippedRows ImportSkippedRow[]

  @@index([master, fingerprint])
}

model ImportSkippedRow {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // The row number as Excel shows it (headings are row 1).
  rowNumber Int
  // The row's cells as uploaded, in heading order.
  cells     Json
  reason    String

  @@unique([jobId, rowNumber])
}

// ---------------------------------------------------------------------------
// Chart of accounts (agent/accounts-plan.md, "Our chart of accounts"). The 28
// Tally groups are seeded as they are in Tally; users add sub-groups. A
// general ledger is any ledger no other master owns (capital, sales,
// purchase, GST, TDS, round off, fixed assets…). Ledger and group names are
// unique across every master, ignoring case (common/tally/ledger-names.ts).
// ---------------------------------------------------------------------------

// Where a primary group's balances appear: Balance Sheet (assets,
// liabilities) or Profit & Loss (income, expenses).
enum GroupNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

model LedgerGroup {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @unique
  // Null: a primary group.
  parentId           String?       @db.Uuid
  parent             LedgerGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: Restrict)
  // Primary groups only; a sub-group takes its parent's (CHECK).
  nature             GroupNature?
  // Primary income and expense groups only: Sales, Purchase, Direct.
  affectsGrossProfit Boolean       @default(false)
  // The 28 Tally groups: never renamed, moved or deleted.
  isPredefined       Boolean       @default(false)
  // Its ledgers stay folded in reports (Sundry Debtors, Sundry Creditors).
  behavesAsSubLedger Boolean       @default(false)
  // Show the net of debit and credit in reports.
  nettBalances       Boolean       @default(false)
  // Order among its siblings in reports (Tally's position index).
  position           Int           @default(0)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  children LedgerGroup[] @relation("GroupTree")
  ledgers  Ledger[]

  @@index([parentId])
}

enum DrCr {
  DR
  CR
}

// Ledgers the app posts to by role (agent/accounts-plan.md, "System ledgers").
enum LedgerRole {
  PROFIT_AND_LOSS
  CAPITAL
  DRAWINGS
  SALES_LOCAL
  SALES_INTERSTATE
  SALES_EXPORT_LUT
  SALES_EXPORT_IGST
  PURCHASE_LOCAL
  PURCHASE_INTERSTATE
  PURCHASE_NO_ITC
  OUTPUT_CGST
  OUTPUT_SGST
  OUTPUT_IGST
  INPUT_CGST
  INPUT_SGST
  INPUT_IGST
  RCM_CGST
  RCM_SGST
  RCM_IGST
  TDS_PAYABLE
  TDS_RECEIVABLE
  IGST_REFUND
  ROUND_OFF
}

// Duties & Taxes ledgers: which tax they hold (Tally's type of duty / tax).
enum TaxKind {
  CGST
  SGST
  IGST
  CESS
  TDS
  TCS
  OTHER
}

model Ledger {
  id             String       @id @default(uuid()) @db.Uuid
  // The Tally ledger name.
  name           String       @unique
  // Null only for Profit & Loss A/c, which Tally keeps under Primary (CHECK).
  groupId        String?      @db.Uuid
  group          LedgerGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  openingBalance Decimal      @default(0) @db.Decimal(14, 2)
  openingSide    DrCr         @default(DR)
  // Seeded ledgers the app posts to: never deleted, renamed or archived.
  systemRole     LedgerRole?  @unique
  // Ledgers under Duties & Taxes only.
  taxKind        TaxKind?
  notes          String?
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  loansAsAsset Loan[] @relation("LoanAssetLedger")
  loansAsTds   Loan[] @relation("LoanTdsLedger")

  @@index([groupId])
}
