# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Matches the local database in ../docker-compose.yml.
DATABASE_URL="postgresql://jqe:jqe_local_dev@localhost:5433/jqe_dashboard?schema=public"

# Origin of the dashboard frontend. Mutating requests from other origins are refused.
FRONTEND_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (the Next.js rewrite counts as one).
TRUST_PROXY_HOPS=1
SESSION_TTL_HOURS=168

# Shared secret the public website sends when recording WhatsApp opt-ins. 32+ characters.
WEBSITE_API_KEY=

# Used once by `npm run db:seed` to create the first administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Admin User"
